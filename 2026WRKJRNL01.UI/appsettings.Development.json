{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Components": "Warning"
    }
  },
  "Environment": "Development",
  // LOCAL / OFFLINE database. SQLite file created next to the app on first run.
  // (The on-network SQL Server connection has been removed.)
  "ConnectionStrings": {
    "2026WRKJRNL01": "Data Source=2026WRKJRNL01.db"
  },
  // Microsoft Clarity Configuration.
  "ClarityConfig": {
    "ClarityEnabled": "false",
    "ClarityAppID": "Insert ID from script here."
  },
  // Email Engine - kept in simulation mode so no mail is actually sent while running locally.
  "EmailEngine": {
    "server": "localhost",
    "port": "587",
    "testing": true, // If enabled, no emails are sent; their contents are redirected to the log.
    "simulation_mode": true, // If enabled, emails are redirected to the addresses below instead of real recipients.
    "simulation_redirects": "localdev@example.local"
  }
}