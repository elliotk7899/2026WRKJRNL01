    <PackageReference Include="SDPBC.Employees.ServiceConnector" Version="1.1.0.7" />
    <PackageReference Include="SDPBC.Logging" Version="1.1.0.14" />
    <PackageReference Include="TinyMCE.Blazor" Version="2.2.1" />
