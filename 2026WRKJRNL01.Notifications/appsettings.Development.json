{
  "ConfigName": "WRKJRNL01 Notification Service - Development",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EmailEngine": {
    "server": "localhost",
    "port": "587",
    // Testing mode - writes email to log.
    "testing": "true",
    // Simulation mode - redirects outgoing mail.
    "simulation_mode": "true",
    "simulation_redirects": "localdev@example.local"
  },
  "ConnectionStrings": {
    // Provide a real connection string via a secret store / environment variable at deploy time.
    "2026WRKJRNL01": ""
  },
  // Employee Service Connector - supply BaseURL/APIKey from a secret store; do not commit.
  "EmployeesSVC": {
    "BaseURL": "",
    "APIKey": ""
  },
  // Valid options for below are as follows:
  //
  //   Schedules the process to run weekly on a specific day / time:
  //      {
  //         "Mode": "Weekly",
  //         "Day": "Sunday",
  //         "Time": "23:59:59"
  //      }
  //
  //   Schedules the process to run daily at a specific time: 
  //      {
  //         "Mode": "Daily",
  //         "Time": "23:59:59"
  //      }
  // 
  //   Schedules the process to run every x hours:
  //      {
  //         "Mode": "Hourly",
  //         "Increment": "12"
  //      }
  //
  //   Schedules the process to run every x minutes:
  //      {
  //         "Mode": "Minutely",
  //         "Increment": "5"
  //      }
  //
  // Defines the frequencey at which the heartbeat will run.
  // Defines how often the worker heartbeat is logged.
  "HeartBeat": {
    "Mode": "Hourly",
    "Increment": "1"
  },
  // Work journal reminder schedule.
  "MissingJournalReminder": {
    "Mode": "Minutely",
    "Increment": "1"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": false,
    "variables": {
      "AppID": "2026WRKJRNLSVC",
      "LogUser": "APP"
    },
    "extensions": [
      {}
    ],
    "targets": {
      "async": false,
      "Console": {
        "type": "Console",
        "layout": "${longdate} ${uppercase:${level}} ${message:withException=true} ${exception:format=data:exceptionDataSeparator=\r\n}"
      },
      "LocalFile": {
        "type": "File",
        "fileName": "logs/${AppID}/${machinename}_${shortdate}.log",
        "archiveFileName": "logs/${AppID}/Archive_${machinename}_${shortdate}.log",
        "archiveEvery": "day",
        "archiveNumbering": "DateAndSequence",
        "archiveAboveSize": "3000000",
        "maxArchiveFiles": 30,
        "layout": "${longdate} ${uppercase:${level}} ${message:withException=true} ${exception:format=data:exceptionDataSeparator=\r\n}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "writeTo": "Console"
      },
      {
        "logger": "*",
        "writeTo": "LocalFile"
      }
    ]
  }
}